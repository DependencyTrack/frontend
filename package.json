{
  "name": "@dependencytrack/frontend",
  "version": "5.2.0",
  "private": true,
  "description": "Single Page Application for OWASP Dependency-Track",
  "author": "Steve Springett",
  "homepage": "https://dependencytrack.org/",
  "copyright": "Copyright OWASP Foundation",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:DependencyTrack/frontend.git"
  },
  "scripts": {
    "start": "npm run serve",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build-image": "npm run build && docker build -f docker/Dockerfile.alpine -t ghcr.io/dependencytrack/frontend:local .",
    "eslint": "eslint . --report-unused-disable-directives",
    "eslint-fix": "eslint . --fix --report-unused-disable-directives",
    "prettier": "prettier --check --cache '**/*.{js,mjs,vue,json,md,yaml}'",
    "prettier-fix": "prettier --write --cache '**/*.{js,mjs,vue,json,md,yaml}'",
    "vue-i18n-extract": "vue-i18n-extract report --ci",
    "remove-unused-i18n": "vue-i18n-extract --remove",
    "e2e": "playwright test -c e2e"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-jinja": "6.0.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/theme-one-dark": "6.1.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@popperjs/core": "2.11.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axios": "1.20.0",
    "bootstrap": "5.3.8",
    "bootstrap-table": "1.27.3",
    "bootstrap-vue-next": "1.2.2",
    "chart.js": "4.5.1",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "easy-pie-chart": "3.2.0",
    "flexver": "1.1.1",
    "imurmurhash": "0.1.4",
    "jquery": "4.0.0",
    "jquery-treegrid": "0.3.0",
    "lodash-es": "4.18.1",
    "oidc-client-ts": "3.5.0",
    "showdown": "2.1.0",
    "showdown-htmlescape": "0.1.9",
    "vue": "3.5.44",
    "vue-chartjs": "5.3.4",
    "vue-i18n": "11.4.14",
    "vue-multiselect": "3.5.0",
    "vue-router": "5.4.0",
    "xss-filters": "1.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-sort-json": "4.2.0",
    "rollup-plugin-sbom": "4.0.1",
    "sass": "1.105.1",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.4",
    "vue-i18n-extract": "git+https://git@github.com/Spittal/vue-i18n-extract.git#f856484d2f62abbd931d84676519f529062d94da",
    "xmlbuilder2": "4.0.3"
  },
  "overrides": {
    "fast-uri": "3.1.2"
  },
  "engines": {
    "node": ">= 22",
    "npm": ">= 10"
  }
}
