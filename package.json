{
  "name": "@dependencytrack/frontend",
  "version": "5.2.0",
  "description": "Single Page Application for OWASP Dependency-Track",
  "author": "Steve Springett",
  "homepage": "https://dependencytrack.org/",
  "copyright": "Copyright OWASP Foundation",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:DependencyTrack/frontend.git"
  },
  "scripts": {
    "start": "npm run serve",
    "serve": "npm run update-embedded-version && vite",
    "update-embedded-version": "node update-embedded-version.js",
    "build": "npm run update-embedded-version && vite build",
    "build-image": "npm run build && docker build -f docker/Dockerfile.alpine -t ghcr.io/dependencytrack/frontend:local .",
    "eslint": "eslint . --report-unused-disable-directives",
    "eslint-fix": "eslint . --fix --report-unused-disable-directives",
    "prettier": "prettier --check --cache '**/*.{js,mjs,vue,json,md,yaml}'",
    "prettier-fix": "prettier --write --cache '**/*.{js,mjs,vue,json,md,yaml}'",
    "vue-i18n-extract": "vue-i18n-extract report --ci",
    "remove-unused-i18n": "vue-i18n-extract --remove"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.2",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-jinja": "6.0.0",
    "@codemirror/lint": "6.9.4",
    "@codemirror/theme-one-dark": "6.1.3",
    "@coreui/coreui": "2.1.16",
    "@coreui/coreui-plugin-chartjs-custom-tooltips": "1.3.1",
    "@coreui/icons": "0.4.1",
    "@coreui/vue": "2.1.2",
    "@johmun/vue-tags-input": "2.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axios": "1.20.0",
    "bootstrap": "4.6.2",
    "bootstrap-table": "1.22.6",
    "bootstrap-vue": "2.23.1",
    "chart.js": "2.9.4",
    "codemirror": "6.0.2",
    "dompurify": "3.4.16",
    "easy-pie-chart": "2.1.7",
    "flexver": "1.1.1",
    "font-awesome": "4.7.0",
    "imurmurhash": "0.1.4",
    "jquery": "3.7.1",
    "jquery-treegrid": "0.3.0",
    "lodash-es": "4.18.1",
    "oidc-client": "1.11.5",
    "showdown": "2.1.0",
    "showdown-htmlescape": "0.1.9",
    "simple-line-icons": "2.5.5",
    "vee-validate": "3.4.15",
    "vue": "2.7.16",
    "vue-axios": "3.5.2",
    "vue-bootstrap-toggle": "1.1.4",
    "vue-chartjs": "3.5.1",
    "vue-debounce": "2.6.0",
    "vue-i18n": "8.28.2",
    "vue-multiselect": "2.1.9",
    "vue-page-title": "1.3.0",
    "vue-router": "3.6.5",
    "vue-toastr": "2.1.2",
    "vue2-org-tree": "1.3.6",
    "xss-filters": "1.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue2": "2.3.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.2.5",
    "prettier-plugin-sort-json": "4.0.0",
    "rollup-plugin-sbom": "4.0.1",
    "sass": "1.105.1",
    "vite": "7.3.7",
    "vue-i18n-extract": "git+https://git@github.com/Spittal/vue-i18n-extract.git#f856484d2f62abbd931d84676519f529062d94da",
    "xmlbuilder2": "4.0.3"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "vue-bootstrap-toggle": {
      "merge": "2.1.1"
    }
  },
  "engines": {
    "node": ">= 22",
    "npm": ">= 10"
  }
}
